{
  "name": "tsgolint-rust",
  "version": "0.1.0",
  "description": "A Rust port of tsgolint on ts-rust: the type-aware linter that oxlint runs for --type-aware and --type-check. Install it as oxlint-tsgolint.",
  "keywords": ["oxlint", "tsgolint", "typescript", "linter", "type-aware"],
  "license": "MIT",
  "author": "tunnckoCore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnckoCoreHQ/tsgolint-rust.git",
    "directory": "npm/tsgolint-rust"
  },
  "bugs": "https://github.com/tunnckoCoreHQ/tsgolint-rust/issues",
  "homepage": "https://github.com/tunnckoCoreHQ/tsgolint-rust#readme",
  "type": "module",
  "bin": {
    "tsgolint": "bin/tsgolint.js"
  },
  "files": ["bin"],
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@tsgolint-rust/darwin-arm64": "0.1.0",
    "@tsgolint-rust/darwin-x64": "0.1.0",
    "@tsgolint-rust/linux-arm64": "0.1.0",
    "@tsgolint-rust/linux-x64": "0.1.0",
    "@tsgolint-rust/win32-arm64": "0.1.0",
    "@tsgolint-rust/win32-x64": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
