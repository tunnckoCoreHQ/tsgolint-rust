{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "CI_OS"
  ],
  "tasks": {
    "//#check": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "crates/**/*.rs",
        "crates/*/Cargo.toml",
        "npm/scripts/**",
        "npm/*/package.json",
        "README.md",
        "UPSTREAM.json",
        "pnpm-workspace.yaml"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*"
      ],
      "outputs": []
    },
    "//#test": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "crates/**",
        "!crates/**/node_modules/**",
        "!crates/tsgolint-rust/e2e/**",
        "!**/*.md"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*",
        "TSGOLINT_ORACLE"
      ],
      "outputs": []
    },
    "//#e2e": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "scripts/e2e.sh",
        "crates/**",
        "!crates/**/node_modules/**",
        "!**/*.md"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*"
      ],
      "outputs": []
    },
    "//#e2e:wasm": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "scripts/e2e.sh",
        "crates/**",
        "!crates/**/node_modules/**",
        "!**/*.md"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*",
        "WASMTIME"
      ],
      "outputs": []
    },
    "//#build": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "crates/tsgolint-core/src/**",
        "crates/tsgolint-core/Cargo.toml",
        "crates/tsgolint-rules/src/**",
        "crates/tsgolint-rules/Cargo.toml",
        "crates/tsgolint-rust/src/**",
        "crates/tsgolint-rust/build.rs",
        "crates/tsgolint-rust/Cargo.toml"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*"
      ],
      "outputs": [
        "target/release/tsgolint",
        "target/wasm32-wasip1/release/tsgolint.wasm"
      ]
    }
  }
}
