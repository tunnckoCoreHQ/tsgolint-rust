{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "//#check": {
      "inputs": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "tsgolint-*/**/*.rs", "tsgolint-*/Cargo.toml"],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*"],
      "outputs": []
    },
    "//#test": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "scripts/test.sh",
        "tsgolint-*/**",
        "!tsgolint-*/**/node_modules/**",
        "!**/*.md"
      ],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*", "WASMTIME", "TSGOLINT_ORACLE"],
      "outputs": []
    },
    "//#build": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "tsgolint-core/src/**",
        "tsgolint-core/Cargo.toml",
        "tsgolint-rules/src/**",
        "tsgolint-rules/Cargo.toml",
        "tsgolint-rust/src/**",
        "tsgolint-rust/build.rs",
        "tsgolint-rust/Cargo.toml"
      ],
      "passThroughEnv": ["CARGO_*", "RUSTUP_*"],
      "outputs": ["target/release/tsgolint", "target/wasm32-wasip1/release/tsgolint.wasm"]
    }
  }
}
