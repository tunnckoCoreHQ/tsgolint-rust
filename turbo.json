{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "RUNNER_OS",
    "RUNNER_ARCH"
  ],
  "tasks": {
    "//#check": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "tsgolint-*/**/*.rs",
        "tsgolint-*/Cargo.toml",
        "npm/scripts/**",
        "npm/*/package.json",
        "README.md",
        "UPSTREAM.json",
        "pnpm-workspace.yaml"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*"
      ],
      "outputs": []
    },
    "//#test": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "tsgolint-*/**",
        "!tsgolint-*/**/node_modules/**",
        "!tsgolint-rust/e2e/**",
        "!**/*.md"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*",
        "TSGOLINT_ORACLE"
      ],
      "outputs": []
    },
    "//#e2e": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "scripts/e2e.sh",
        "tsgolint-*/**",
        "!tsgolint-*/**/node_modules/**",
        "!**/*.md"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*"
      ],
      "outputs": []
    },
    "//#e2e:wasm": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "pnpm-lock.yaml",
        "scripts/e2e.sh",
        "tsgolint-*/**",
        "!tsgolint-*/**/node_modules/**",
        "!**/*.md"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*",
        "WASMTIME"
      ],
      "outputs": []
    },
    "//#build": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "tsgolint-core/src/**",
        "tsgolint-core/Cargo.toml",
        "tsgolint-rules/src/**",
        "tsgolint-rules/Cargo.toml",
        "tsgolint-rust/src/**",
        "tsgolint-rust/build.rs",
        "tsgolint-rust/Cargo.toml"
      ],
      "passThroughEnv": [
        "CARGO_*",
        "RUSTUP_*"
      ],
      "outputs": [
        "target/release/tsgolint",
        "target/wasm32-wasip1/release/tsgolint.wasm"
      ]
    }
  }
}
